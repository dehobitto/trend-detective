# Copy to backend/.env (gitignored). Never commit real values.
# NASA Earthdata Login: https://urs.earthdata.nasa.gov/users/new
# Verified setup: all three set. Token: Profile -> Generate Token (valid 60 days).
TD_EARTHDATA_USERNAME=
TD_EARTHDATA_PASSWORD=
TD_EARTHDATA_TOKEN=
# Once per account, in the browser (https://urs.earthdata.nasa.gov/profile):
#  - Applications -> Authorized Apps: approve "NASA GESDISC DATA ARCHIVE"
#  - for night lights (LAADS): fill in User Type, Organization, Study Area in the profile,
#    then approve "LAADS Web" (https://urs.earthdata.nasa.gov/approve_app?client_id=A6th7HB-3EBoO7iOCiCLlA)

# Field guide chat (LLM). Without a key the chat falls back to canned stub replies.
TD_CHAT_BACKEND=fieldguide
# openai (key: https://platform.openai.com/api-keys, needs prepaid credit) or gemini (free key: https://aistudio.google.com/apikey)
TD_CHAT_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model override (defaults: gpt-5-mini / gemini-flash-latest)
TD_CHAT_MODEL=
